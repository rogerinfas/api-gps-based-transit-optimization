  "info": {
    "title": "GPS Transit Optimization API",
    "description": "Backend API documentation",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateVehicleDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Identificador interno del bus",
            "example": "BUS-AQP-001",
            "minLength": 1,
            "maxLength": 64
          },
          "plateNumber": {
            "type": "object",
            "description": "Placa peruana asignada al vehículo",
            "example": "ABC-123",
            "maxLength": 32,
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Estado operativo del bus",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "MAINTENANCE"
            ],
            "example": "ACTIVE"
          },
          "capacity": {
            "type": "object",
            "description": "Capacidad de pasajeros",
            "example": 80,
            "minimum": 1,
            "nullable": true
          },
          "routeId": {
            "type": "object",
            "description": "Identificador de la ruta asignada",
            "example": "ckxyz123",
            "maxLength": 64,
            "nullable": true
          }
        },
        "required": [
          "code"
        ]
      },
      "VehicleResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único del vehículo",
            "example": "ckxyz123"
          },
          "code": {
            "type": "string",
            "description": "Identificador interno del bus",
            "example": "BUS-AQP-001"
          },
          "plateNumber": {
            "type": "object",
            "description": "Placa peruana del vehículo",
            "example": "ABC-123",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Estado operativo del vehículo",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "MAINTENANCE"
            ],
            "example": "ACTIVE"
          },
          "capacity": {
            "type": "object",
            "description": "Capacidad de pasajeros",
            "example": 80,
            "nullable": true
          },
          "routeId": {
            "type": "object",
            "description": "Identificador de la ruta asignada",
            "example": "ckxyz789",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "description": "Fecha de creación en formato ISO 8601",
            "example": "2026-04-28T15:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "description": "Fecha de última actualización en formato ISO 8601",
            "example": "2026-04-28T15:00:00.000Z"
          }
        },
        "required": [
          "id",
          "code",
          "plateNumber",
          "status",
          "capacity",
          "routeId",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateVehicleDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Identificador interno del bus",
            "example": "BUS-AQP-001",
            "minLength": 1,
            "maxLength": 64
          },
          "plateNumber": {
            "type": "object",
            "description": "Placa peruana asignada al vehículo",
            "example": "ABC-123",
            "maxLength": 32,
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Estado operativo del bus",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "MAINTENANCE"
            ],
            "example": "ACTIVE"
          },
          "capacity": {
            "type": "object",
            "description": "Capacidad de pasajeros",
            "example": 80,
            "minimum": 1,
            "nullable": true
          },
          "routeId": {
            "type": "object",
            "description": "Identificador de la ruta asignada",
            "example": "ckxyz123",
            "maxLength": 64,
            "nullable": true
          }
        }
      },
      "CreateRouteDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Código único de la ruta",
            "example": "AQP-CHAR-LA",
            "minLength": 1,
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "description": "Nombre comercial visible de la ruta",
            "example": "CHARACATO L A",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "object",
            "description": "Descripción opcional para operaciones",
            "example": "Ruta urbana Characato - Linea A",
            "maxLength": 255,
            "nullable": true
          },
          "isActive": {
            "type": "boolean",
            "description": "Indica si la ruta está operativa",
            "example": true
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "RouteResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único de la ruta",
            "example": "ckxyz789"
          },
          "code": {
            "type": "string",
            "description": "Código único de la ruta",
            "example": "AQP-CHAR-LA"
          },
          "name": {
            "type": "string",
            "description": "Nombre comercial visible de la ruta",
            "example": "CHARACATO L A"
          },
          "description": {
            "type": "object",
            "description": "Descripción de la ruta",
            "example": "Ruta urbana Characato - Linea A",
            "nullable": true
          },
          "isActive": {
            "type": "boolean",
            "description": "Indica si la ruta está operativa",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "description": "Fecha de creación en ISO 8601",
            "example": "2026-04-28T15:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "description": "Fecha de última actualización en ISO 8601",
            "example": "2026-04-28T15:00:00.000Z"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "description",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateRouteDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Código único de la ruta",
            "example": "AQP-CHAR-LA",
            "minLength": 1,
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "description": "Nombre comercial visible de la ruta",
            "example": "CHARACATO L A",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "object",
            "description": "Descripción opcional para operaciones",
            "example": "Ruta urbana Characato - Linea A",
            "maxLength": 255,
            "nullable": true
          },
          "isActive": {
            "type": "boolean",
            "description": "Indica si la ruta está operativa",
            "example": true
          }
        }
      }
    }
  }
}