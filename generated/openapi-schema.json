{
  "openapi": "3.0.0",
  "paths": {
    "/vehicles": {
      "post": {
        "operationId": "VehicleController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVehicleDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "El código o la placa ya existen"
          }
        },
        "summary": "Crear un vehículo (bus)",
        "tags": [
          "Vehicles"
        ]
      },
      "get": {
        "operationId": "VehicleController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VehicleResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Listar todos los vehículos",
        "tags": [
          "Vehicles"
        ]
      }
    },
    "/vehicles/{id}": {
      "get": {
        "operationId": "VehicleController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador del vehículo",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado"
          }
        },
        "summary": "Obtener un vehículo por id",
        "tags": [
          "Vehicles"
        ]
      },
      "patch": {
        "operationId": "VehicleController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador del vehículo",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateVehicleDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Vehículo no encontrado"
          },
          "409": {
            "description": "El código o la placa ya existen"
          }
        },
        "summary": "Actualizar parcialmente un vehículo",
        "tags": [
          "Vehicles"
        ]
      },
      "delete": {
        "operationId": "VehicleController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador del vehículo",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Vehículo eliminado"
          },
          "404": {
            "description": "Vehículo no encontrado"
          }
        },
        "summary": "Eliminar un vehículo",
        "tags": [
          "Vehicles"
        ]
      }
    },
    "/routes": {
      "post": {
        "operationId": "RouteController_create",
