        ]
      },
      "delete": {
        "operationId": "RouteController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador de la ruta",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Ruta eliminada"
          },
          "404": {
            "description": "Ruta no encontrada"
          }
        },
        "summary": "Eliminar una ruta",
        "tags": [
