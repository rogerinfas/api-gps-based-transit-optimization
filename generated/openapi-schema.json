            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RouteResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Listar todas las rutas",
        "tags": [
          "Routes"
        ]
      }
    },
    "/routes/{id}": {
      "get": {
        "operationId": "RouteController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador de la ruta",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Ruta no encontrada"
          }
        },
        "summary": "Obtener una ruta por id",
        "tags": [
          "Routes"
        ]
      },
      "patch": {
        "operationId": "RouteController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador de la ruta",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRouteDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Ruta no encontrada"
          },
          "409": {
            "description": "El código de ruta ya existe"
          }
        },
        "summary": "Actualizar parcialmente una ruta",
        "tags": [
