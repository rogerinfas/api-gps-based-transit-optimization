// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Route {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique
  name          String
  description   String?
  imageUrl      String?
  color         String          @default("#3b82f6")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  routeStops    RouteStop[]
  vehicles      Vehicle[]
  etaPredictions EtaPrediction[]
  outboundPath  Unsupported("geometry(LineString, 4326)")?
  returnPath    Unsupported("geometry(LineString, 4326)")?

  @@index([isActive])
}

model Stop {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique
  name           String
  latitude       Decimal         @db.Decimal(9, 6)
  longitude      Decimal         @db.Decimal(9, 6)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  routeStops     RouteStop[]
  etaPredictions EtaPrediction[]
  location      Unsupported("geometry(Point, 4326)")?

  @@index([isActive])
}

model RouteStop {
  routeId                     String   @db.Uuid
  stopId                      String   @db.Uuid
  stopOrder                   Int
  distanceFromRouteStartMeters Int?
  plannedTravelSeconds        Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  route                       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop                        Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@id([routeId, stopId])
  @@unique([routeId, stopOrder])
  @@index([stopId])
}

model Vehicle {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique
  plateNumber    String?         @unique
  status         VehicleStatus   @default(ACTIVE)
  capacity       Int?
  routeId        String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  route          Route?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  gpsPositions   GpsPosition[]
  etaPredictions EtaPrediction[]

  @@index([status])
  @@index([routeId])
}

model GpsPosition {
  id             String    @id @default(uuid()) @db.Uuid
  vehicleId      String    @db.Uuid
  latitude       Decimal   @db.Decimal(9, 6)
  longitude      Decimal   @db.Decimal(9, 6)
  speedKph       Decimal?  @db.Decimal(5, 2)
  headingDegrees Decimal?  @db.Decimal(5, 2)
  recordedAt     DateTime
  createdAt      DateTime  @default(now())
  location       Unsupported("geometry(Point, 4326)")?
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt(sort: Desc)])
}

model EtaPrediction {
  id                 String    @id @default(uuid()) @db.Uuid
  vehicleId          String    @db.Uuid
  routeId            String    @db.Uuid
  stopId             String    @db.Uuid
  etaSeconds         Int
  predictedArrivalAt DateTime
  confidence         Decimal?  @db.Decimal(5, 2)
  calculatedAt       DateTime  @default(now())
  createdAt          DateTime  @default(now())
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route              Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop               Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([vehicleId, calculatedAt(sort: Desc)])
  @@index([routeId, stopId, predictedArrivalAt])
}
